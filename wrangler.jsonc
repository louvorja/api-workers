{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "api",
  "main": "src/index.ts",
  "account_id": "ebfd182d9bc3913163758a88118752f5",
  "compatibility_date": "2026-08-22",

  // O endereço workers.dev é o que os apps usam e precisa continuar ligado:
  // quando há rotas declaradas, o padrão do wrangler passa a ser desligá-lo.
  "workers_dev": true,

  // Rotas de api.louvorja.com.br atendidas por este Worker, para tirar a carga
  // do servidor PHP, que continua por trás do mesmo endereço. O que não está
  // listado segue indo para ele:
  // - /auth, /admin e /tasks: o painel antigo, que grava no MySQL;
  // - /file/musics: o MP3 original. O catálogo já não aponta para ele (ver
  //   src/lib/media-urls.ts), mas quem tem endereço antigo guardado ainda usa;
  // - /health: para continuar medindo o servidor antigo.
  // O FTP do programa Delphi não passa por HTTP: /ftp só entrega o endereço dele.
  // A zona vai pelo identificador: existe outra com o mesmo nome (a antiga, já
  // movida, em outra conta), e pelo nome as rotas caíam nela e não valiam.
  "routes": [
    { "pattern": "api.louvorja.com.br/params*", "zone_id": "cbec6f75b761dabdc81ac07031af0dee" },
    { "pattern": "api.louvorja.com.br/ftp*", "zone_id": "cbec6f75b761dabdc81ac07031af0dee" },
    { "pattern": "api.louvorja.com.br/download*", "zone_id": "cbec6f75b761dabdc81ac07031af0dee" },
    { "pattern": "api.louvorja.com.br/onlinevideos*", "zone_id": "cbec6f75b761dabdc81ac07031af0dee" },
    { "pattern": "api.louvorja.com.br/version*", "zone_id": "cbec6f75b761dabdc81ac07031af0dee" },
    { "pattern": "api.louvorja.com.br/player*", "zone_id": "cbec6f75b761dabdc81ac07031af0dee" },
    { "pattern": "api.louvorja.com.br/metadata*", "zone_id": "cbec6f75b761dabdc81ac07031af0dee" },
    { "pattern": "api.louvorja.com.br/json_db*", "zone_id": "cbec6f75b761dabdc81ac07031af0dee" },
    { "pattern": "api.louvorja.com.br/db/*", "zone_id": "cbec6f75b761dabdc81ac07031af0dee" },
    { "pattern": "api.louvorja.com.br/file/covers/*", "zone_id": "cbec6f75b761dabdc81ac07031af0dee" },
    { "pattern": "api.louvorja.com.br/file/images/*", "zone_id": "cbec6f75b761dabdc81ac07031af0dee" },
    { "pattern": "api.louvorja.com.br/pt*", "zone_id": "cbec6f75b761dabdc81ac07031af0dee" },
    { "pattern": "api.louvorja.com.br/es*", "zone_id": "cbec6f75b761dabdc81ac07031af0dee" }
  ],

  // Workers Caching (não o caches.default): faz read-through, colapsa
  // requisições concorrentes para o mesmo objeto frio e fatia Range sozinho —
  // ele remove o header Range antes de invocar o Worker, guarda o 200 inteiro e
  // devolve o 206. cross_version_cache mantém o cache entre deploys porque o
  // conteúdo é estático e não muda junto com o código.
  // cross_version_cache fica FALSO (padrão) de propósito. Com max-age de um ano
  // nas mídias, compartilhar o cache entre versões faria uma correção de
  // comportamento continuar invisível por um ano nas URLs já aquecidas — foi o
  // que aconteceu ao restringir os prefixos de /file. Cada deploy parte de um
  // cache vazio; como o conteúdo é estático e os deploys são raros, a perda de
  // hit rate é barata perto de servir resposta errada.
  "cache": {
    "enabled": true,
    "cross_version_cache": false
  },

  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },

  // Bucket único: mídia (covers/, images/, musics/) e o dump do banco
  // estático sob json_db/. Ver scripts/ingest.ts.
  "r2_buckets": [
    {
      "binding": "FILES",
      "bucket_name": "files"
    }
  ],

  // Banco relacional do catálogo e do painel (/auth, /admin). Em `wrangler dev`
  // o binding aponta para um SQLite local em .wrangler/, não para este banco.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "louvorja",
      "database_id": "4705d209-b837-4cc3-b515-610470555605",
      "migrations_dir": "migrations"
    }
  ],

  // Mesmos tetos por minuto da API PHP. Os namespaces são independentes para
  // arquivos, metadados e demais rotas.
  "ratelimits": [
    {
      "name": "RATE_LIMIT_FILES",
      "namespace_id": "910001",
      "simple": { "limit": 10000, "period": 60 }
    },
    {
      "name": "RATE_LIMIT_METADATA",
      "namespace_id": "910002",
      "simple": { "limit": 10000, "period": 60 }
    },
    {
      "name": "RATE_LIMIT_GENERAL",
      "namespace_id": "910003",
      "simple": { "limit": 5000, "period": 60 }
    }
  ],

  // Declarar a lista impede o wrangler de injetar as chaves de ingestão do
  // .env como variáveis do Worker durante o dev. JWT_SECRET assina os tokens do
  // painel; em dev ele vem de .dev.vars. Os demais são opcionais e por isso
  // ficam de fora: GITHUB_TASK_TOKEN (sem ele /tasks responde 503) e
  // TELEGRAM_BOT_TOKEN/TELEGRAM_CHAT_ID (aviso de alteração no catálogo).
  "secrets": { "required": ["JWT_SECRET"] },

  "vars": {
    "GITHUB_TASK_REF": "main",
    "GITHUB_TASK_REPO": "louvorja/api-workers"
  }
}
