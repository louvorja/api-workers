{
  "$schema": "../node_modules/wrangler/config-schema.json",
  // Painel de administração: só arquivos estáticos, sem código no Worker.
  // Requisições a assets estáticos não contam como invocação.
  "name": "adm",
  "account_id": "ebfd182d9bc3913163758a88118752f5",
  "compatibility_date": "2026-08-22",
  "assets": {
    "directory": "./dist",
    // O painel usa rotas do vue-router em modo history (/musics, /albums...).
    "not_found_handling": "single-page-application"
  }
}
